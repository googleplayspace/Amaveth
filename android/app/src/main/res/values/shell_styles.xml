<resources>
    <style name="ImShellTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Spec 8.4 (2) / 9.6: system SplashScreen for the launcher entry. White matches the
         page's first screen; after the splash ImActivity continues with ImShellTheme. -->
    <style name="ImSplashTheme" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/shell_start_background</item>
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/shell_splash_art</item>
        <item name="postSplashScreenTheme">@style/ImShellTheme</item>
    </style>
</resources>
